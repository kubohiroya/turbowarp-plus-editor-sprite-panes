{
  "name": "@kubohiroya/turbowarp-plus-editor-sprite-panes",
  "version": "0.1.2-clone-pagination.1",
  "description": "Panes of the TurboWarp Plus Editor sprite editor: assets, variables, messages, properties and the section toolbar",
  "type": "module",
  "license": "MPL-2.0",
  "author": "Hiroya Kubo",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kubohiroya/turbowarp-plus-editor-sprite-panes.git"
  },
  "exports": {
    "./sprite-asset-pane": {
      "types": "./dist/sprite-asset-pane.d.ts",
      "default": "./dist/sprite-asset-pane.js"
    },
    "./sprite-asset-pane.css": "./src/sprite-asset-pane.css",
    "./sprite-message-pane": {
      "types": "./dist/sprite-message-pane.d.ts",
      "default": "./dist/sprite-message-pane.js"
    },
    "./sprite-clone-inspector": {
      "types": "./dist/sprite-clone-inspector.d.ts",
      "default": "./dist/sprite-clone-inspector.js"
    },
    "./sprite-properties": {
      "types": "./dist/sprite-properties.d.ts",
      "default": "./dist/sprite-properties.js"
    },
    "./sprite-properties.css": "./src/sprite-properties.css",
    "./sprite-editor-toolbar": {
      "types": "./dist/sprite-editor-toolbar.d.ts",
      "default": "./dist/sprite-editor-toolbar.js"
    },
    "./sprite-editor-toolbar.css": "./src/sprite-editor-toolbar.css",
    "./native-tile-title": {
      "types": "./dist/native-tile-title.d.ts",
      "default": "./dist/native-tile-title.js"
    }
  },
  "files": [
    "dist",
    "src",
    "tsconfig.json",
    "README.md",
    "README.ja.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && tsc -p example/tsconfig.json",
    "prepare": "npm run build",
    "test": "npm run build && node --test test/*.test.ts",
    "test:browser": "npm run build && node --test test/*.browser.ts"
  },
  "dependencies": {
    "@kubohiroya/turbowarp-plus-editor-project-model": "0.1.0"
  },
  "peerDependencies": {
    "react": ">=16.14",
    "react-dom": ">=16.14"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "jsdom": "26.1.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "typescript": "6.0.3"
  }
}
